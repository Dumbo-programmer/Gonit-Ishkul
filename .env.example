# ─── Database ────────────────────────────────────────────────
# Production target: PostgreSQL (see prisma/schema.prisma).
# Local dev may use the JSON-backed repository (no DB required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gonit_ishkul?schema=public"

# Set to "prisma" to use the Prisma/PostgreSQL repository.
# Leave unset/"json" to use the built-in file-backed dev store.
DATA_SOURCE="json"

# ─── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or any long random string)
NEXTAUTH_SECRET="change-me-in-production-please-000000000"
NEXTAUTH_URL="http://localhost:3000"

# Seeds the demo admin account on first run (JSON store only).
SEED_ADMIN_EMAIL="admin@gonitishkul.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Seeds the universal (full-access) admin account on first run (JSON store only).
SEED_SUPERADMIN_EMAIL="superadmin@gonitishkul.local"
SEED_SUPERADMIN_PASSWORD="SuperAdmin@12345"
